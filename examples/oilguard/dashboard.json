{
  "uid": "oilguard-ai-dashboard",
  "title": "OilGuard AI - Oil Field Safety",
  "tags": [
    "openegiz",
    "oilguard",
    "safety"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "description": "OilGuard AI: monitoring pressure, temperature and vibration in simulated oil wells.",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Pressure - WELL-02",
      "datasource": {
        "type": "influxdb",
        "uid": "opentwins-influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pressure",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "opentwins-influxdb"
          },
          "query": "from(bucket: \"default\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.thingId == \"org.openegiz.oilguard:WELL-02\" and r._field == \"pressure_properties_value\")"
        }
      ]
    },
    {
